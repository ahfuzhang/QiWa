FROM linuxserver/code-server:latest

WORKDIR /tmp/code-server
RUN apt-get update \
 && apt-get install -y --no-install-recommends curl unzip clang lld binutils zlib1g-dev wget make \
                       nodejs npm ca-certificates \
 && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://dot.net/v1/dotnet-install.sh -o dotnet-install.sh && \
    chmod +x dotnet-install.sh && \
    ./dotnet-install.sh --channel 6.0 --install-dir /usr/share/dotnet

RUN curl -sSL https://aka.ms/getvsdbgsh | /bin/sh /dev/stdin -v latest -l /usr/bin/vsdbg
WORKDIR /tmp/netcoredbg
RUN wget https://github.com/Samsung/netcoredbg/releases/download/3.1.3-1062/netcoredbg-linux-amd64.tar.gz \
 && tar -zxf netcoredbg-linux-amd64.tar.gz -C /usr/bin/

ENV DOTNET_ROOT="/usr/share/dotnet"
ENV PATH="$DOTNET_ROOT:/usr/bin/vsdbg:/usr/bin/netcoredbg:/usr/share/dotnet/sdk/6.0.428:${PATH}"

#RUN dotnet tool install -g dotnet-dump && \
#    dotnet tool install -g dotnet-trace

RUN dotnet tool install dotnet-trace --version 8.0.0 --tool-path /usr/share/dotnet/sdk/6.0.428/
RUN npm install -g speedscope

#####################
# 你想预装的插件列表（扩展ID）
ARG EXTENSIONS="\
  ms-dotnettools.vscode-dotnet-runtime \
  ms-dotnettools.csharp \
  ms-dotnettools.csdevkit \
  tamasfe.even-better-toml \
  ms-vscode.makefile-tools \
  jexus.netcoredbg \
  redhat.vscode-yaml \
"

# linuxserver 镜像通常以 abc 用户运行；用 root 装完再把权限给回去更稳
USER root

# 安装插件到固定目录（建议放到 /config/extensions，和该镜像的持久化逻辑一致）
RUN export EXTENSIONS_GALLERY='{"serviceUrl":"https://marketplace.visualstudio.com/_apis/public/gallery"}' \
  && mkdir -p /config/extensions \
  && for ext in $EXTENSIONS; do \
       echo "Installing $ext"; \
       /app/code-server/bin/code-server \
         --extensions-dir /config/extensions \
         --install-extension "$ext" \
         --force \
       || { echo "ERROR: failed to install extension: $ext" >&2; exit 1; }; \
     done \
  && chown -R abc:abc /config

USER abc
